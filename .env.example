# Local example. Populate secrets only in the appropriate private environment.
APP_ENV=development
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server and worker only.
# DATABASE_URL is used by isolated migration/test tooling, never by browser commands.
# Local scripts can read generated credentials from ignored .local/database.json.
DATABASE_URL=
WORKER_DATABASE_URL=
SUPABASE_SECRET_KEY=
SECRET_ENCRYPTION_KEY=
SECRET_ENCRYPTION_KEY_ID=v1
# Optional private JSON map of retired key IDs to their 64-character hex keys.
# Retain historical keys while immutable approved destinations reference them.
SECRET_ENCRYPTION_PREVIOUS_KEYS=

# Local adapter choices. Email supports fake, resend and ses.
# Production configuration validates every required adapter.
EMAIL_ADAPTER=fake
CALENDAR_ADAPTER=fake
WHATSAPP_ADAPTER=fake
FILE_SCAN_ADAPTER=fake
PAYMENT_RECONCILIATION_ADAPTER=manual

# Sender address for either live email adapter.
EMAIL_FROM=

# Resend app-outbox delivery and signed callbacks.
# Set a sending-only API key and the signing secret from the Resend webhook settings.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# SES delivery and authenticated notification callbacks.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
EMAIL_SNS_TOPIC_ARN=
EMAIL_CONFIGURATION_SET=

# Google OAuth calendar connection.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_CALENDAR_ID=

# Official WhatsApp Business Platform.
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=

# Private malware-scanning service.
FILE_SCAN_URL=
