{
  "name": "git-tutor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.22.2 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker:dev": "tsx --env-file-if-exists=.env.local --conditions=react-server src/worker/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:recovery:payout": "tsx --conditions=react-server tools/recovery-rehearsal.ts --unknown-payout",
    "test:e2e": "playwright test",
    "db:start": "powershell -NoProfile -File tools/db-start.ps1 && tsx tools/supabase-local.ts bootstrap",
    "db:migrate": "tsx tools/db-migrate.ts && tsx tools/supabase-local.ts migrate",
    "db:verify": "tsx tools/db-verify.ts && tsx tools/supabase-local.ts verify",
    "seed:synthetic": "tsx tools/db-seed.ts && tsx tools/supabase-local.ts seed",
    "supabase:start": "tsx tools/supabase-local.ts bootstrap",
    "supabase:restart": "tsx tools/supabase-local.ts restart",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:integration && pnpm test:e2e && pnpm build",
    "verify:pack": "python tools/verify-pack.py"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "3.1166.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@vercel/sandbox": "4.1.0",
    "next": "16.4.6",
    "nodemailer": "10.5.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "three": "0.187.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "supabase": "3.1.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
