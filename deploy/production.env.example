# Runtime template only. Store real settings outside the repository in the host secret manager.
# Do not copy preview credentials, APP_ENV=development or fictional practice data.
APP_ENV=production
APP_BASE_URL=https://YOUR_PRODUCTION_DOMAIN
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
WORKER_DATABASE_URL=
SECRET_ENCRYPTION_KEY=
SECRET_ENCRYPTION_KEY_ID=v1
SECRET_ENCRYPTION_PREVIOUS_KEYS=
# Use an address on a Resend-verified sending domain.
EMAIL_ADAPTER=resend
EMAIL_FROM=
# Create a sending-only key and subscribe the app's /api/webhooks/resend endpoint
# to email.sent, email.delivered, email.bounced and email.failed.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# SES alternative with EMAIL_ADAPTER=ses uses /api/webhooks/email.
# AWS_REGION=
# EMAIL_SNS_TOPIC_ARN=
# EMAIL_CONFIGURATION_SET=
# Prefer the host's scoped AWS role/identity; otherwise inject AWS credentials privately.
CALENDAR_ADAPTER=google
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://YOUR_PRODUCTION_DOMAIN/api/calendar/google/callback
GOOGLE_CALENDAR_ID=
WHATSAPP_ADAPTER=cloud
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=
FILE_SCAN_ADAPTER=clamav
FILE_SCAN_URL=tcp://YOUR_PRIVATE_SCANNER:3310
PAYMENT_RECONCILIATION_ADAPTER=manual
