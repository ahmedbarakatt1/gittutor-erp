# Operator-only preflight settings. Never pass PRODUCTION_DATABASE_URL to the web/worker.
PRODUCTION_PROJECT_REF=
# Restricted runtime worker uses git_tutor_worker; operator uses postgres for read-only inspection.
# Direct example: postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=verify-full
# Session pooler example: postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full
PRODUCTION_DATABASE_URL=
