      "credit_quanta_per_session": {"type": "integer", "const": 1000},
      "grant_credit_quanta": {"type": "integer", "minimum": 1},
      "base_duration_minutes": {"type": "integer", "minimum": 1},
      "eligible_formats": {"type": "array", "minimum_items": 1, "allowed_items": ["private", "group"]},
      "expiry_modes": ["none", "days_from_grant"],
      "days_from_grant_requires": ["expiry_days"],
      "coverage_rules": ["named_entitlement_covers_eligible_occurrence", "allocated_value_with_explicit_top_up"],
      "coverage_semantics": {
        "named_entitlement_covers_eligible_occurrence": {
          "confirmation_basis": "required_eligible_reserved_credit_quanta",
          "funding_source": "reserved_named_package_entitlement",
          "fully_covered_service_additional_tuition_receivable_minor": 0,
          "standalone_price_role": "reference_only",
          "revenue_basis": "consumed_lot_allocated_carrying_value",
          "partial_coverage_requires_explicit_remaining_service_proposal": true
        },
        "allocated_value_with_explicit_top_up": {
          "confirmation_basis": "monetary_policy_threshold",
          "funding_source": "reserved_eligible_package_value",
          "additional_tuition_receivable": "agreed_charge_less_applied_package_value_and_payment_allocations",
          "revenue_basis": "agreed_tuition_with_package_funded_portion_counted_once"
        }
      },
      "lineage_must_be_acyclic": true,
      "carryover_preserves_actual_remaining_value": true
    }
  },
  "publication_gate": {
    "scope": "live_offer_publication",
    "local_development_uses_synthetic_examples": true,
    "reject_synthetic_policy_ids": true,
    "required_fields_common": [
      "policy_version_id", "environment_scope", "is_synthetic", "approved_by", "approved_at", "effective_at", "offer_format",
      "currency", "pricing_unit", "duration_minutes", "customer_pricing_version", "compensation_policy_version",
      "hold_minutes", "confirmation_deadline_minutes_before_start", "deposit_basis_points", "deposit_rounding",
      "confirmation_funding_sources", "customer_cancellation_windows", "tutor_cancellation_compensation_rule",
      "platform_or_tutor_cancellation_remedy", "learner_no_show_rule", "tutor_fee_for_delivered_session",
      "individual_early_departure_rule", "partial_class_remedy_rule", "partial_class_rounding",
      "allowed_refund_remedies", "package_enabled"
    ],
    "required_fields_for_group": [
      "group_target_size", "group_capacity", "group_minimum_size", "formation_failure_action",
      "amendment_acceptance_rule", "amendment_acceptance_minutes", "latest_amendment_minutes_before_start", "post_confirmation_dropout_price_guarantee",
      "below_minimum_group_action"
    ],
    "required_fields_for_private": ["private_seat_price_minor", "private_fee_rule"],
    "required_when_package_enabled": ["package_contract"],
    "validation_rules": [
      "all_applicable_required_fields_are_present_and_non_null",
      "false_and_zero_are_values_not_missing_fields",
      "live_publication_requires_production_scope_and_is_synthetic_false",
      "status_is_approved_before_atomic_transition_to_published",
      "approval_covers_every_applicable_setting_and_pricing_context",
      "published_policy_is_immutable",
      "effective_at_is_a_valid_instant",
      "currency_and_unit_match_approved_price_contract",
      "all_money_and_basis_point_fields_are_integers",
      "minimum_size_lte_target_size_lte_capacity",
      "every_saleable_size_has_an_approved_tier",
      "cancellation_windows_have_no_overlap_or_prestart_gap",
      "refund_basis_points_are_between_zero_and_10000",
      "private_fee_min_lte_fee_max",
      "package_contract_is_complete_if_enabled",
      "package_funding_source_requires_package_enabled",
      "named_entitlement_coverage_uses_unit_based_funding_and_zero_additional_debt_when_fully_covered",
      "value_top_up_coverage_uses_explicit_value_based_funding_and_monetary_threshold",
      "package_entitlement_remedy_requires_package_enabled",
      "package_quantity_is_integer_credit_quanta_with_1000_quanta_per_standard_session",
      "package_credit_units_define_base_duration_and_eligible_formats",
      "day_based_expiry_has_positive_integer_expiry_days",
      "duration_proration_has_explicit_rounding_and_approval_rule"
    ]
  },
